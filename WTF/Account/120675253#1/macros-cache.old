VER 3 0000000000000006 "testes" "134400"
/run local t,id=GetCursorInfo() if t~="item" then local _,l=GameTooltip:GetItem() id=l and tonumber(l:match("item:(%d+)")) end if id then Scrap:ToggleJunk(id) ClearCursor() end
END
